{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noImplicitAny": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "noEmit": true,
    "noResolve": true,
    "strict": false,
    "types": []
  },
  "include": [
    "src/web/ui/client/**/*.d.ts",
    "src/web/ui/client/**/*.js",
    "src/web/ui/client/**/*.ts"
  ],
  "exclude": [
    "src/web/ui/client/core/api-routes.generated.js"
  ]
}
