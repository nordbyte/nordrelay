{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "noResolve": true,
    "strict": false,
    "types": []
  },
  "include": [
    "src/web/ui/client/**/*.d.ts",
    "src/web/ui/client/**/*.js"
  ],
  "exclude": [
    "src/web/ui/client/core/api-routes.generated.js",
    "src/web/ui/client/core/api-client.js"
  ]
}
