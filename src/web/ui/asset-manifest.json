  "staticAssets": [
    { "name": "favicon.ico", "contentType": "image/x-icon" },
    { "name": "favicon.png", "contentType": "image/png" },
    { "name": "logo.png", "contentType": "image/png" },
    { "name": "manifest.webmanifest", "contentType": "application/manifest+json; charset=utf-8" },
    { "name": "service-worker.js", "contentType": "application/javascript; charset=utf-8" }
  ]
}
